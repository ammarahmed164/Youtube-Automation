# ==============================================================================
# AI YouTube Documentary Studio - Environment Configuration Template
# Copy this file to backend/.env and provide your credentials.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_DEBUG=true

# Database (Supabase PostgreSQL)
# Example: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_URL=https://ubdijlujjjkqxcloqudz.supabase.co
SUPABASE_ANON_KEY=

# AI Provider (Google Gemini API)
GEMINI_API_KEY=

# Stock Visual Assets (Pexels API)
PEXELS_API_KEY=

# Local Rendering Tools
FFMPEG_BIN_PATH=ffmpeg
PIPER_BIN_PATH=piper

# YouTube Data API v3 & Google OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/callback

# Strict System Constraints
MAX_VIDEO_DURATION_MINUTES=20

